# Security headers for the adriano SPA. Rendered at container start by
# docker-entrypoint.d/40-render-app-config.sh, which fills the
# CSP_IDP_SOURCES placeholder with the validated origin of
# OIDC_AUTHORITY (or nothing when OIDC is not configured). The image
# also ships this file pre-rendered with no IdP (see Dockerfile), so
# nginx always has a valid snippet.
#
# Included at server level AND inside every location that sets its
# own add_header: nginx drops all inherited add_header directives in
# a location that declares any of its own.
#
# connect-src: oidc-client-ts fetches the IdP discovery document,
# token and userinfo endpoints from the browser. frame-src: its
# silent renew loads the IdP authorize endpoint in a hidden iframe.
#
# Vuetify sets theme CSS variables via inline `style` attributes at
# runtime, which requires style-src 'unsafe-inline' (there is no nonce
# mechanism for style *attributes*, only for <style> elements).
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'${CSP_IDP_SOURCES}; frame-src 'self'${CSP_IDP_SOURCES}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
