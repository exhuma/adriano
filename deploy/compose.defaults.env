# Defaults for the bundled docker-compose.yml stack. Loaded FIRST as
# an env_file, so anything in your own env file (.env by default, see
# ADRIANO_BACKEND_ENV_FILE) overrides it. Contains no secrets.
#
# Database: the bundled `db` service with its default credentials.
# Change ADRIANO_DATABASE_URL in your env file to use an external
# PostgreSQL, or when you changed ADRIANO_DB_USER/PASSWORD/NAME.
ADRIANO_DATABASE_URL=postgresql://adriano:adriano@db:5432/adriano

# Where docker-compose.yml mounts the catalog inside the container.
ADRIANO_CONFIG_FILE=/app/catalog.yaml
