# Example environment file for the adriano backend.
#
# Copy to .env (gitignored) and adjust for your machine. Every
# field below corresponds to a field on app.config.Settings. All
# variables use the ADRIANO_ prefix. Values here point at the
# ephemeral dev database started with `task db:up` (host port
# 55432) and contain no secrets.

# Plain postgresql:// DSN for the application database. The
# SQLAlchemy +psycopg dialect modifier is added in code, not here.
ADRIANO_DATABASE_URL=postgresql://adriano:adriano@localhost:55432/adriano

# DSN used only by the backend test suite (pytest).
ADRIANO_TEST_DATABASE_URL=postgresql://adriano:adriano@localhost:55432/adriano_test

# Path to the catalog.yaml file describing sources and policy.
# Not read until phase 04; left here for forward documentation.
ADRIANO_CONFIG_FILE=./catalog.yaml

# OIDC resource-server settings. The backend validates RS256 bearer
# tokens against the JWKS named by the IdP discovery document
# (<authority>/.well-known/openid-configuration), fetched lazily on
# the first request (an unreachable IdP answers 503, never a crash).
# ADRIANO_OIDC_AUTHORITY is the IdP discovery base URL (setting it
#   enables OIDC),
# ADRIANO_OIDC_ISSUER is the expected `iss` claim (unset: the
#   discovery document's `issuer`),
# ADRIANO_OIDC_AUDIENCE is the expected `aud` claim (default shown),
# ADRIANO_OIDC_ROLES_CLAIM is the dotted path to a list of role
#   names in the token (default `roles`; Keycloak:
#   `realm_access.roles`).
# Without OIDC and without the dev secret below, every /api/v1 route
# answers 503 "authentication is not configured" and /healthz
# reports `auth: unconfigured`.
# ADRIANO_OIDC_AUTHORITY=https://idp.example.com/realms/adr
# ADRIANO_OIDC_ISSUER=https://idp.example.com/realms/adr
ADRIANO_OIDC_AUDIENCE=adr_viewer
ADRIANO_OIDC_ROLES_CLAIM=roles

# Dev-only HS256 auth bypass (local development and E2E only).
# - ADRIANO_DEV_SHARED_SECRET: when set, HS256 tokens signed with it
#   are accepted (same aud/iss checks; iss is ADRIANO_OIDC_ISSUER if
#   set, else `adriano-dev`). Use a random value of at least 32
#   bytes, e.g. `openssl rand -hex 32`. There is no default.
# - ADRIANO_DEV_AUTH_ENABLED=true additionally mounts
#   POST /auth/dev/token (mints a token for any identity; ignored
#   with an error log when the secret is unset).
# Both MUST be unset in production. Mint tokens on the command line
# with `task mint-dev-token -- --sub alice --roles admin`.
ADRIANO_DEV_AUTH_ENABLED=false
# ADRIANO_DEV_SHARED_SECRET=

# Frontend half of the dev login: shows the "Dev sign-in" dialog under
# `task dev` / `task dev:frontend` only (Vite dev server). Production
# builds never contain the dev login, whatever this says.
# VITE_DEV_AUTH=true

# Minutes after a registration's last successful poll before
# GET /api/v1/sources and record detail freshness report it as
# stale. A registration that never succeeded, or whose last poll
# failed or was partial, is always stale regardless of this value.
ADRIANO_STALE_AFTER_MINUTES=120

# --- docker-compose.yml only (not read by app.config.Settings) ---
#
# Read directly by docker-compose.yml / the backend container's CMD;
# see docs/operator.md "Install and run" and "Configuration file and
# environment reference".
#
# Number of Uvicorn worker processes (backend/Dockerfile's CMD). The
# legacy application ran 5; this image defaults to 4.
# ADRIANO_WORKERS=4
#
# Host port the `frontend` service publishes (container always
# listens on 8080 internally). 8180 avoids host ports 8000/8080,
# which are commonly already in use.
# ADRIANO_FRONTEND_PORT=8180
#
# Database credentials for the compose-managed `db` service (NOT the
# `task db:up` ephemeral dev/test database on port 55432, which is
# unrelated and always uses adriano/adriano).
# ADRIANO_DB_USER=adriano
# ADRIANO_DB_PASSWORD=adriano
# ADRIANO_DB_NAME=adriano
#
# Path (on the Docker host) to the catalog.yaml mounted into the
# `backend`/`migrate` containers; defaults to the bundled
# catalog.demo.yaml. Point it at your own catalog.yaml for a non-demo
# deployment.
# ADRIANO_CATALOG_FILE_HOST=./catalog.demo.yaml
#
# CI push bearer token for the `central` filesystem registration in
# catalog.demo.yaml (see samples/push-candidate.sh). No default;
# `task demo` generates one into the gitignored .env.demo.
# ADRIANO_PUSH_TOKEN_CENTRAL=
#
# Runtime config passed to the frontend container's entrypoint (see
# frontend/config.template.js); all optional, same meaning as the
# ADRIANO_OIDC_* variables above.
# ADRIANO_OIDC_CLIENT_ID=
# ADRIANO_OIDC_REDIRECT_URI=
# ADRIANO_OIDC_POST_LOGOUT_REDIRECT_URI=
# ADRIANO_OIDC_SCOPE=
# ADRIANO_FRONTEND_API_BASE_URL=
